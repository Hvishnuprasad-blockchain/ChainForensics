pragma solidity ^0.8.19;

/**
 * @title ForensicLedger
 * @notice Immutable forensic-event hash ledger for ChainForensics.
 *
 * Sprint 2 responsibilities:
 * - Store forensic event hashes.
 * - Reject empty hashes.
 * - Reject duplicate hashes.
 * - Validate indexes on reads.
 * - Emit events for every state change.
 * - Allow authorized recovery verification in Sprint 4.
 *
 * IMPORTANT:
 * The contract stores the SHA-256 hash produced by the Python
 * forensic-event builder. The complete forensic event remains
 * outside the blockchain.
 */
contract ForensicLedger {

    // =========================================================
    // Data structures
    // =========================================================

    struct LedgerEntry {
        bytes32 eventHash;
        uint256 timestamp;
        address recorder;
        bool recoveryVerified;
    }

    // All recorded forensic events.
    LedgerEntry[] private entries;

    // Explicit duplicate protection.
    //
    // eventHash => true when the hash has already been recorded.
    //
    // This prevents replaying the exact same forensic event.
    mapping(bytes32 => bool) public hashExists;

    // Owner is used for Sprint 4 recovery verification.
    address public immutable owner;


    // =========================================================
    // Events
    // =========================================================

    /**
     * Emitted whenever a new forensic event is written.
     */
    event EventLogged(
        uint256 indexed index,
        bytes32 indexed eventHash,
        uint256 timestamp,
        address indexed recorder
    );

    /**
     * Emitted whenever recovery verification changes.
     */
    event RecoveryVerified(
        uint256 indexed index,
        bytes32 indexed eventHash,
        address indexed verifier,
        uint256 timestamp
    );


    // =========================================================
    // Errors
    // =========================================================

    error EmptyHash();

    error DuplicateHash(bytes32 eventHash);

    error IndexOutOfBounds(
        uint256 index,
        uint256 length
    );

    error NotOwner();


    // =========================================================
    // Constructor
    // =========================================================

    constructor() {
        owner = msg.sender;
    }


    // =========================================================
    // Modifiers
    // =========================================================

    modifier validIndex(uint256 index) {
        if (index >= entries.length) {
            revert IndexOutOfBounds(
                index,
                entries.length
            );
        }

        _;
    }

    modifier onlyOwner() {
        if (msg.sender != owner) {
            revert NotOwner();
        }

        _;
    }


    // =========================================================
    // Write
    // =========================================================

    /**
     * @notice Record a new forensic event hash.
     *
     * @param eventHash SHA-256 hash generated by the
     *                  ChainForensics forensic-event builder.
     *
     * @return index Index assigned to the new ledger entry.
     */
    function logEvent(
        bytes32 eventHash
    )
        external
        returns (uint256 index)
    {
        // Reject empty hashes.
        if (eventHash == bytes32(0)) {
            revert EmptyHash();
        }

        // Explicit duplicate-hash protection.
        //
        // This is the core replay/tamper defense:
        // once a hash exists, the exact same event hash
        // cannot be inserted again.
        if (hashExists[eventHash]) {
            revert DuplicateHash(eventHash);
        }

        index = entries.length;

        entries.push(
            LedgerEntry({
                eventHash: eventHash,
                timestamp: block.timestamp,
                recorder: msg.sender,
                recoveryVerified: false
            })
        );

        hashExists[eventHash] = true;

        emit EventLogged(
            index,
            eventHash,
            block.timestamp,
            msg.sender
        );
    }


    // =========================================================
    // Sprint 4 recovery verification
    // =========================================================

    /**
     * @notice Mark a previously recorded event as recovery verified.
     *
     * @dev Reserved for Sprint 4.
     *      Owner-only so arbitrary accounts cannot falsely
     *      claim that recovery has been verified.
     */
    function markRecoveryVerified(
        uint256 index
    )
        external
        onlyOwner
        validIndex(index)
    {
        entries[index].recoveryVerified = true;

        emit RecoveryVerified(
            index,
            entries[index].eventHash,
            msg.sender,
            block.timestamp
        );
    }


    // =========================================================
    // Reads
    // =========================================================

    /**
     * @notice Return the total number of ledger entries.
     */
    function getEntryCount()
        external
        view
        returns (uint256)
    {
        return entries.length;
    }


    /**
     * @notice Return a complete ledger entry.
     *
     * @dev Index bounds are explicitly validated.
     */
    function getEntry(
        uint256 index
    )
        external
        view
        validIndex(index)
        returns (
            bytes32 eventHash,
            uint256 timestamp,
            address recorder,
            bool recoveryVerified
        )
    {
        LedgerEntry storage entry = entries[index];

        return (
            entry.eventHash,
            entry.timestamp,
            entry.recorder,
            entry.recoveryVerified
        );
    }


    /**
     * @notice Return only the event hash for an entry.
     *
     * @dev Index bounds are explicitly validated.
     */
    function getEventHash(
        uint256 index
    )
        external
        view
        validIndex(index)
        returns (bytes32)
    {
        return entries[index].eventHash;
    }


    /**
     * @notice Return the recovery verification state.
     *
     * @dev Index bounds are explicitly validated.
     */
    function isRecoveryVerified(
        uint256 index
    )
        external
        view
        validIndex(index)
        returns (bool)
    {
        return entries[index].recoveryVerified;
    }
}